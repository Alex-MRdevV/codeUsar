---
import { LoginForm } from "@/components/user/login";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="login">
	<main>
		<LoginForm client:visible />
	</main>
</Layout>

<script>
	import { type userDevolver } from "@/utils/types/user";

	const routes: Record<userDevolver["rol"], string> = {
		user: "user",
	};

	window.addEventListener("userAuthenticate", (event) => {
		const user = (event as CustomEvent<userDevolver>).detail;

		if (!user?.rol) return;

		const target = routes[user.rol] || "/user/index";
		window.location.assign(target);
	});
</script>
