# WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_WABA_ID=your_whatsapp_waba_id_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here

# MySQL Database Configuration (if applicable)
DB_PASS=your_db_password_here
DB_NAME=your_db_name_here
DB_HOST=your_db_host_here
DB_USER=your_db_user_here
DB_PORT=3306

# Authentication & Security
SECRET_KEY_JWT=your_secret_key_jwt_here

# Clerk Authentication (if applicable)
PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Turso (libSQL) Database Configuration
DATABASE_URL="libsql://your_turso_db_url_here"
