---
import { MessageReplies } from "@/components/responder/mensajeReplicar";
import Layout from "@/layouts/LayoutUsers.astro";
import { sidebarDataItems } from "@/lib/sidebarItems";
import { getUserSidebarData } from "@/utils/getUserDataLayout";

const data = await getUserSidebarData(Astro, sidebarDataItems);
---

<Layout
	title="Responder Mensajes de WhatsApp"
	description="Gestiona y responde mensajes entrantes de WhatsApp de manera eficiente."
	data={data}
>
	<MessageReplies />
</Layout>
