---
import { WelcomeCard } from "@/components/welcome/welcome";
import Layout from "@/layouts/LayoutUsers.astro";
import { getUserStats } from "@/lib/drizzle/stats/stadistics";
import { sidebarDataItems } from "@/lib/sidebarItems";
import { getUserSidebarData } from "@/utils/getUserDataLayout";

const data = await getUserSidebarData(Astro, sidebarDataItems);
const { locals } = Astro;
// --- Obtener userId desde la sesión ---
const sessionUser = locals.user ?? null;
const userId = (sessionUser?.id as string) ?? null;

if (!userId) {
	throw new Error("Usuario no autenticado o sin ID válido.");
}

// --- Ejecutar consulta preparada (solo UserStats) ---
const stmt = getUserStats;
const result = await stmt.execute({ userId });

// --- Obtener estadísticas ---
const rawStats = result[0]?.userStats ?? null;

type WelcomeStats = {
	totalMessagesSent: number;
	totalTimeSavedHours: number;
	totalContacts: number;
};

const userStats: WelcomeStats = {
	totalMessagesSent: Number(rawStats?.totalMessagesSent ?? 0),
	totalTimeSavedHours: Number(rawStats?.totalTimeSavedHours ?? 0),
	totalContacts: Number(rawStats?.totalContacts ?? 0),
};
---

<Layout
	title={`Bienvenido ${data.user.name}`}
	description="Automatizar envíos de mensajes de WhatsApp para mejorar la comunicación con clientes."
	data={data}
>
	<main class="min-h-screen bg-background">
		<div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
			<WelcomeCard nombre={data.user.name} stats={userStats} client:visible />
		</div>
	</main>
</Layout>
