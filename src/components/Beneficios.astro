---
import { Clock, Settings, Shield, Zap } from "lucide-react";

const features = [
	{
		icon: Clock,
		title: "Confirmaciones Instantáneas",
		description:
			"Automatiza confirmaciones de pedidos, entregas y cambios de estado sin intervención manual.",
	},
	{
		icon: Zap,
		title: "Integración API Meta",
		description:
			"Conecta directamente con la API oficial de WhatsApp Business para máxima confiabilidad.",
	},
	{
		icon: Shield,
		title: "Cumplimiento Legal",
		description:
			"Respeta regulaciones de privacidad y políticas de WhatsApp.",
	},
	{
		icon: Settings,
		title: "Fácil Configuración",
		description:
			"Sin código necesario. Configura flujos de mensajes de forma visual.",
	},
];
---

<section class="w-full py-12 md:py-24 lg:py-32 bg-muted/40 dark:bg-muted/10">
	<div class="container px-4 md:px-6">
		{/* Header */}
		<div
			class="flex flex-col items-center justify-center space-y-4 text-center mb-12"
		>
			<div class="space-y-2">
				<h2
					class="text-3xl font-bold tracking-tighter md:text-4xl/tight text-foreground"
				>
					Características Poderosas
				</h2>
				<p
					class="max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed"
				>
					Todo lo necesario para escalar la comunicación con clientes a
					través de WhatsApp
				</p>
			</div>
		</div>

		{/* Features Grid */}
		<div
			class="mx-auto grid max-w-5xl items-start gap-8 py-6 lg:grid-cols-2 lg:gap-10"
		>
			{
				features.map((feature) => {
					const IconComponent = feature.icon;
					return (
						<div class="grid gap-4 group hover:bg-card hover:rounded-lg hover:p-4 transition-all duration-200">
							<div class="flex items-start gap-4">
								<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-primary shrink-0 group-hover:bg-primary/20 transition-colors">
									<IconComponent className="h-6 w-6" />
								</div>
								<div class="space-y-2">
									<h3 class="text-xl font-bold text-foreground">
										{feature.title}
									</h3>
									<p class="text-muted-foreground leading-relaxed">
										{feature.description}
									</p>
								</div>
							</div>
						</div>
					);
				})
			}
		</div>
		</div>
	</div>
</section>

<style>
	:root {
		color-scheme: light dark;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--background: oklch(0.145 0 0);
			--foreground: oklch(0.985 0 0);
			--card: oklch(0.145 0 0);
			--card-foreground: oklch(0.985 0 0);
			--primary: oklch(0.488 0.243 264.376);
			--primary-foreground: oklch(0.985 0 0);
			--muted: oklch(0.269 0 0);
			--muted-foreground: oklch(0.708 0 0);
			--border: oklch(0.269 0 0);
		}
	}

	@media (prefers-color-scheme: light) {
		:root {
			--background: oklch(1 0 0);
			--foreground: oklch(0.145 0 0);
			--card: oklch(1 0 0);
			--card-foreground: oklch(0.145 0 0);
			--primary: oklch(0.205 0 0);
			--primary-foreground: oklch(0.985 0 0);
			--muted: oklch(0.97 0 0);
			--muted-foreground: oklch(0.556 0 0);
			--border: oklch(0.922 0 0);
		}
	}
</style>
