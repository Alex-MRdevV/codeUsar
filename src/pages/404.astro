---
import Layout from "../layouts/Layout.astro";
import { FiAlertTriangle } from "react-icons/fi";
---

<Layout title="Página no encontrada">
	<main
		class="flex flex-col justify-center items-center min-h-[90vh] mx-auto px-[100px] pt-[300px] bg-gray-100 dark:bg-gray-900"
	>
		<div class="text-center">
			<header class="flex justify-center items-center mb-6">
				<h1
					class="text-6xl font-bold text-red-600 dark:text-red-500 flex items-center"
				>
					404
					<span class="ml-4 text-5xl">
						<FiAlertTriangle style={{ color: "orange", fontSize: "3rem" }} />
					</span>
				</h1>
			</header>
			<p class="text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-2">
				Página no encontrada
			</p>
			<p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
				La ruta que estás buscando no existe o fue movida.
			</p>

			href="/" class="bg-blue-600 dark:bg-blue-700 text-white py-3 px-6
			rounded-md text-lg hover:bg-blue-700 dark:hover:bg-blue-600
			hover:text-white transition duration-300" > Volver al Inicio
		</div>
	</main>
</Layout>
