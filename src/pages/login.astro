---
import { LoginForm } from "@/components/user/login";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="login">
	<main>
		<LoginForm client:visible />
	</main>
</Layout>

<script>
	import { type userDevolver } from "@/utils/types/user";

	const routes: Record<userDevolver["rol"], string> = {
		user: "/user/index",
	};

	window.addEventListener("userAuthenticate", (event) => {
		const customEvent = event as CustomEvent<userDevolver>;
		const user = customEvent.detail;

		setTimeout(() => {
			if (user?.rol === routes[user.rol]) {
				window.location.href = "/user/index";
			}
		}, 100);
	});
</script>
