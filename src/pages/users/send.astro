---
import Layout from "@/layouts/LayoutUsers.astro";
import { SendMessages } from "@/components/messages/send";
import type { Template } from "@/utils/types/templates";

const templates: Template[] = [
	{
		id: "1800976767240211",
		name: "Pedidos No Planeados",
		metaTemplateName: "pedidos_no_planeados",
		language: "es_CO",
		structure: {
			header: {
				type: "TEXT",
				text: "Su pedido no fue planeado",
			},
			body: {
				text: "Estimado(a) {{1}}, lamentamos informar que su pedido no pudo ser planeado y por lo tanto no será entregado. Agradecemos colocarse en contacto con tu supervisor comercial para mayor información.\n\nPedimos disculpas por los inconvenientes causados.",
				example: ["Juan"],
			},
		},
		variables: {
			format: "positional",
			params: [
				{
					name: "1",
					placeholder: "{{1}}",
					example: "Juan",
					component: "body",
				},
			],
		},
	},
	{
		id: "1512906759962471",
		name: "Pedidos Retrasados",
		metaTemplateName: "pedidos_retrasados",
		language: "es_CO",
		structure: {
			header: {
				type: "TEXT",
				text: "Vamos con retraso",
			},
			body: {
				text: "*Estimado/a {{1}}*\n\nLamentamos mucho informarte que tu pedido no podrá llegar hoy como planeamos 😔.\nPero queremos asegurarte que mañana estará en tus manos sin falta ✅.\n¡Gracias por tu paciencia y comprensión! 💛",
				example: ["Raul"],
			},
		},
		variables: {
			format: "positional",
			params: [
				{
					name: "1",
					placeholder: "{{1}}",
					example: "Raul",
					component: "body",
				},
			],
		},
	},
	{
		id: "1361569685755538",
		name: "Confirmar Pedido",
		metaTemplateName: "confirmar_pedido",
		language: "es_CO",
		structure: {
			header: {
				type: "TEXT",
				text: "{{1}}, ¡Tenemos algo nuevo para ti!",
				example: "Carlos",
			},
			body: {
				text: "🎉Ahora podrás ver el detalle de tu pedido en tiempo real, fácilmente desde nuestra nueva herramienta 🔧📱.\n\nQueremos que te sientas siempre acompañado y con toda la información que necesitas, cuando la necesites. Sólo necesitas ingresar tu código de cliente 🔍",
			},
			buttons: [
				{
					type: "URL",
					text: "¡Conócela ahora!",
					url: "https://bavarianow.logisticos.com.co/",
				},
			],
		},
		variables: {
			format: "positional",
			params: [
				{
					name: "1",
					placeholder: "{{1}}",
					example: "Carlos",
					component: "header",
				},
			],
		},
	},
	{
		id: "2016210562250527",
		name: "Confirmación de Pedido",
		metaTemplateName: "confirmacion_de_pedido",
		language: "es_CO",
		structure: {
			header: {
				type: "TEXT",
				text: "¡Buenas noticias!",
			},
			body: {
				text: "Tu pedido está en camino 🚛 y será entregado entre las {{1}} y {{2}}. Por favor, asegúrate de tener el envase listo según las referencias del pedido y el medio de pago definido cuando llegue nuestro equipo de entrega 🍻🍻",
				example: ["6:00 am", "6:30 am"],
			},
			footer: {
				text: "Atte: Centro de distribución",
			},
		},
		variables: {
			format: "positional",
			params: [
				{
					name: "1",
					placeholder: "{{1}}",
					example: "6:00 am",
					component: "body",
				},
				{
					name: "2",
					placeholder: "{{2}}",
					example: "6:30 am",
					component: "body",
				},
			],
		},
	},
];
---

<Layout title="Send Message">
	<SendMessages templates={templates} client:visible />
</Layout>
