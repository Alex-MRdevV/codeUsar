{
	"main": "dist/_worker.js/index.js",
	"name": "",
	"compatibility_date": "2025-11-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"database": [
		{
			"binding": "DB",
			"database_name": "my-worker-db",
			"database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
		}
	]
}
