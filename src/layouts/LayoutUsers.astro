---
import { TourWrapper } from "@/components/provider";
import { SidebarLayout } from "@/components/sidebar/provider";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

const { title, description, data } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/mensaje.svg" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<div class="flex-container">
			<TourWrapper client:only>
				<SidebarLayout data={data} client:only>
					<slot />
				</SidebarLayout>
			</TourWrapper>
		</div>
	</body>
</html>
