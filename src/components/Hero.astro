---
import { CustomSignedIn } from "@/components/welcome/buttonsLogin";
import CustomSignInButton from "@/components/welcome/buttonsNoLogin";
import { SignedOut } from "@clerk/astro/react";
import { Clock, MessageCircle, TrendingUp, Users } from "lucide-react";

const { title, subtitle } = Astro.props;
---

<section class="w-full py-12 md:py-16 lg:py-20 bg-white dark:bg-gray-950">
	<div class="container px-4 md:px-6">
		<div class="grid gap-6 lg:grid-cols-[1fr_500px] lg:gap-12 items-center">
			<div class="flex flex-col justify-center space-y-4">
				<div class="space-y-2">
					<h1
						class="text-3xl font-bold tracking-tighter sm:text-4xl xl:text-5xl/none text-gray-950 dark:text-gray-50"
					>
						{title}
					</h1>
					<p class="max-w-[600px] text-gray-600 dark:text-gray-400 md:text-xl">
						{subtitle}
					</p>
				</div>

				{/* Key Statistics Cards */}
				<div class="grid grid-cols-2 gap-4 mt-6 sm:grid-cols-4">
					<div
						class="border border-gray-200 dark:border-gray-800 rounded-lg p-4 flex flex-col items-center justify-center text-center bg-white dark:bg-gray-950 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors"
					>
						<MessageCircle
							className="h-8 w-8 text-violet-600 dark:text-violet-500 mb-2"
						/>
						<h3 class="text-2xl font-bold text-gray-950 dark:text-gray-50">
							50%
						</h3>
						<p class="text-xs text-gray-600 dark:text-gray-400">
							Menos llamadas
						</p>
					</div>
					<div
						class="border border-gray-200 dark:border-gray-800 rounded-lg p-4 flex flex-col items-center justify-center text-center bg-white dark:bg-gray-950 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors"
					>
						<Clock
							className="h-8 w-8 text-violet-600 dark:text-violet-500 mb-2"
						/>
						<h3 class="text-2xl font-bold text-gray-950 dark:text-gray-50">
							9h/mes
						</h3>
						<p class="text-xs text-gray-600 dark:text-gray-400">
							Tiempo ahorrado
						</p>
					</div>
					<div
						class="border border-gray-200 dark:border-gray-800 rounded-lg p-4 flex flex-col items-center justify-center text-center bg-white dark:bg-gray-950 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors"
					>
						<Users
							className="h-8 w-8 text-violet-600 dark:text-violet-500 mb-2"
						/>
						<h3 class="text-2xl font-bold text-gray-950 dark:text-gray-50">
							1000k+
						</h3>
						<p class="text-xs text-gray-600 dark:text-gray-400">Mensajes/día</p>
					</div>
					<div
						class="border border-gray-200 dark:border-gray-800 rounded-lg p-4 flex flex-col items-center justify-center text-center bg-white dark:bg-gray-950 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors"
					>
						<TrendingUp
							className="h-8 w-8 text-violet-600 dark:text-violet-500 mb-2"
						/>
						<h3 class="text-2xl font-bold text-gray-950 dark:text-gray-50">
							60%
						</h3>
						<p class="text-xs text-gray-600 dark:text-gray-400">Tasa lectura</p>
					</div>
				</div>

				<CustomSignedIn client:load />
			</div>

			{/* Message Preview Card */}
			<article class="flex items-center justify-center">
				<div
					class="w-full max-w-md border-2 border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden bg-white dark:bg-gray-950"
				>
					<div
						class="bg-violet-600/10 dark:bg-violet-500/10 p-4 border-b border-gray-200 dark:border-gray-800"
					>
						<h3
							class="font-medium text-gray-950 dark:text-gray-50 flex items-center gap-2"
						>
							<MessageCircle
								className="h-4 w-4 text-violet-600 dark:text-violet-500"
							/>
							Confirmación de entrega
						</h3>
					</div>
					<div class="p-4 space-y-4">
						<div class="space-y-2">
							<p class="text-sm text-gray-600 dark:text-gray-400 font-medium">
								Ejemplo de mensaje automatizado:
							</p>
							<div
								class="bg-gray-100 dark:bg-gray-900 rounded-lg p-3 text-sm text-gray-950 dark:text-gray-50"
							>
								Tu pedido está en camino 🚛 y será entregado entre las 6:00 am y
								6:30 am.
							</div>
						</div>
						<section
							class="grid grid-cols-2 gap-3 pt-2 border-t border-gray-200 dark:border-gray-800"
						>
							<div class="text-center">
								<p class="text-xs text-gray-600 dark:text-gray-400 mb-1">
									Enviados
								</p>
								<p class="text-xl font-bold text-gray-950 dark:text-gray-50">
									700
								</p>
							</div>
							<section class="text-center">
								<p class="text-xs text-gray-600 dark:text-gray-400 mb-1">
									Leídos
								</p>
								<p
									class="text-xl font-bold text-violet-600 dark:text-violet-500"
								>
									420
								</p>
							</section>
						</section>
					</div>
				</div>
			</article>
		</div>
	</div>
</section>
