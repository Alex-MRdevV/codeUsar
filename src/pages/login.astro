---
import { LoginForm } from "@/components/user/login";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="login">
	<main>
		<LoginForm client:visible />
	</main>
</Layout>

<script>
	import { type userDevolver } from "@/utils/types/user";

	const routes: Record<userDevolver["rol"], string> = {
		user: "/user/index",
	};

	// Función para comprobar si la cookie ya está disponible
	function checkCookie(name: string) {
		return document.cookie
			.split("; ")
			.some((row) => row.startsWith(`${name}=`));
	}

	window.addEventListener("userAuthenticate", (event) => {
		const customEvent = event as CustomEvent<userDevolver>;
		const user = customEvent.detail;

		const route = routes[user.rol];
		if (!route) return;

		// Reintentar hasta que la cookie exista (máx. 1.5s)
		let tries = 0;
		const interval = setInterval(() => {
			if (checkCookie("tokenAcceso") || tries > 15) {
				clearInterval(interval);
				window.location.href = "/user/index";
			}
			tries++;
		}, 100);
	});
</script>
