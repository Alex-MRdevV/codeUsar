---
import { HistorialAplicado } from "@/components/historial/view";
import Layout from "@/layouts/LayoutUsers.astro";
import { getTemplatesForHistory } from "@/lib/drizzle/templates/templates";
import { sidebarDataItems } from "@/lib/sidebarItems";
import { getUserSidebarData } from "@/utils/getUserDataLayout";

const data = await getUserSidebarData(Astro, sidebarDataItems);

// --- Obtener plantillas usando la consulta preparada
const templatesHistoryConsulta = getTemplatesForHistory;
const templatesHistoryData = await templatesHistoryConsulta.execute();

// Transformar los datos al formato que espera HistorialAplicadoProps
const templatesHistory = templatesHistoryData.map((t) => ({
	id: Number(t.id) || 0,
	name: t.name,
	icon: t.icon || "📄",
	count: t.count || 0,
	color: t.color || "#3b82f6",
}));

const statsConfig = [
	{
		label: "Total Mensajes",
		value: templatesHistory.reduce((acc, t) => acc + t.count, 0),
		icon: "📊",
		description: "Mensajes enviados este mes",
		trendColor: "green",
	},
	{
		label: "Plantilla Más Usada",
		value:
			templatesHistory.length > 0
				? templatesHistory.reduce(
						(max, t) => (t.count > max.count ? t : max),
						templatesHistory[0]
					).name
				: "Seguimiento",
		icon: "🏆",
		description: "Mayor uso",
	},
	{
		label: "Promedio por Plantilla",
		value:
			templatesHistory.length > 0
				? Math.round(
						templatesHistory.reduce((acc, t) => acc + t.count, 0) /
							templatesHistory.length
					)
				: 0,
		icon: "📈",
		description: "Mensajes por plantilla",
		trendColor: "green",
	},
	{
		label: "Total de Plantillas",
		value: templatesHistory.length,
		icon: "📋",
		description: "Activas",
	},
];
---

<Layout
	title="Historial de Aplicados"
	description="Automatizar envíos de mensajes de WhatsApp para mejorar la comunicación con clientes."
	data={data}
>
	<HistorialAplicado
		templates={templatesHistory}
		statsConfig={statsConfig}
		client:visible
	/>
</Layout>
